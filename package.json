{
  "name": "@marchw/packagelens",
  "version": "0.1.0",
  "description": "Understand What Your Dependencies Are Doing - Dependency Intelligence CLI",
  "type": "module",
  "bin": {
    "packagelens": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waeterr/PACKAGELENS.git"
  },
  "bugs": {
    "url": "https://github.com/waeterr/PACKAGELENS/issues"
  },
  "homepage": "https://github.com/waeterr/PACKAGELENS#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run format:check",
    "prepack": "npm run verify"
  },
  "keywords": [
    "dependency",
    "analysis",
    "cli",
    "npm",
    "package",
    "tree",
    "graph"
  ],
  "author": "waeterr",
  "license": "MIT",
  "dependencies": {
    "@marchw/packagelens": "^0.1.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.8"
  }
}
